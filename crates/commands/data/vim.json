      "compound": "[\"testNotEditable\", [\"testNumberWithNameExists:\", \"operator\", \"or:\", [[\"testNumberWithName:isEqualToNumber:\", \"operator\", 1, [\"selectParagraph\", \"cutWithName:\", \"Delete\", \"discardSelectionWithName:\", \"operatorStart\", \"discardNumberWithName:\", \"operator\", \"break:\", 999], \"break:\", 999], [\"testNumberWithName:isEqualToNumber:\", \"operator\", 2, [\"selectParagraph\", \"copyWithName:\", \"clipboard\", \"collapseSelectionToStart\", \"discardSelectionWithName:\", \"operatorStart\", \"discardNumberWithName:\", \"operator\", \"break:\", 999], \"break:\", 999], [\"testNumberWithName:isEqualToNumber:\", \"operator\", 3, [\"selectParagraph\", \"cutWithName:\", \"Delete\", \"discardSelectionWithName:\", \"operatorStart\", \"discardNumberWithName:\", \"operator\", \"makeEditable\", \"break:\", 999], \"break:\", 999]]], \"saveSelectionWithName:\", \"operatorStart\", \"setNumber:withName:\", 3, \"operator\"]"
    },
