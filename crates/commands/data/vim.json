    },
    {
      "title": "Page Down",
      "key": "^f",
      "compound": "[\"testNotEditable\", \"pageDown\", \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "Page Up",
      "key": "^b",
