{
  "title": "Vim",
  "read_only": true,
  "bindings": [
    {
      "title": "Load",
      "key": "",
      "compound": "[\"makeNotEditable\"]"
    },
    {
      "title": "Unload",
      "key": "",
      "compound": "[\"makeEditable\"]"
    },
    {
      "title": "Helper: Insert",
      "key": "",
      "compound": "[\"makeEditable\", \"collapseSelection\", \"discardNumberWithName:\", \"repeat\"]"
    },
    {
      "title": "Helper: Exit Modes",
      "key": "",
      "compound": "[\"makeNotEditable\", \"collapseSelection\", \"moveLeft\"]"
    },
    {
      "title": "Helper: Anchor",
      "key": "",
      "compound": "[\"testSelectionWithNameExists:\", \"anchor\", \"break:\", 999, \"saveSelectionWithName:\", \"anchor\"]"
    },
    {
      "title": "Helper: Motion Pre",
      "key": "",
      "compound": "[\"testSelectionWithNameExists:\", \"anchor\", \"break:\", 999, \"saveSelectionWithName:\", \"anchor\"]"
    },
    {
      "title": "Helper: Motion Post",
      "key": "",
      "compound": "[\"discardSelectionWithName:\", \"anchor\"]"
    },
    {
      "title": "Helper: Recursive Repeat",
      "key": "",
      "compound": "[\"testNumberWithName:isGreaterThanNumber:\", \"repeat\", 0, \"subtractFromNumberWithName:number:\", \"repeat\", 1, [\"testNumberWithName:isEqualToNumber:\", \"repeat\", 0, \"break:\", 2], \"callEnclosingCommandList:\", 2]"
    },
    {
      "title": "Helper: Motion Post Command",
      "key": "",
      "compound": "[\"testNumberWithNameExists:\", \"operator\", \"or:\", [[\"testNumberWithName:isEqualToNumber:\", \"operator\", 1, \"selectToSelectionWithName:\", \"operatorStart\", \"cutWithName:\", \"Delete\", \"discardSelectionWithName:\", \"operatorStart\", \"discardNumberWithName:\", \"operator\", \"break:\", 1], [\"testNumberWithName:isEqualToNumber:\", \"operator\", 2, \"selectToSelectionWithName:\", \"operatorStart\", \"copyWithName:\", \"clipboard\", \"collapseSelectionToStart\", \"discardSelectionWithName:\", \"operatorStart\", \"discardNumberWithName:\", \"operator\", \"break:\", 1], [\"testNumberWithName:isEqualToNumber:\", \"operator\", 3, \"selectToSelectionWithName:\", \"operatorStart\", \"cutWithName:\", \"Delete\", \"discardSelectionWithName:\", \"operatorStart\", \"discardNumberWithName:\", \"operator\", \"makeEditable\", \"break:\", 1]]]"
    },
    {
      "title": "Move Left",
      "key": "h",
      "compound": "[\"testNotEditable\", \"or:\", [[\"testSelectedLengthGreaterThan:\", 0, \"moveLeftAndModifySelection\"], [\"moveLeft\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "Move Right",
      "key": "l",
      "compound": "[\"testNotEditable\", \"or:\", [[\"testSelectedLengthGreaterThan:\", 0, \"moveRightAndModifySelection\"], [\"moveRight\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "Move Up",
      "key": "k",
      "compound": "[\"testNotEditable\", \"or:\", [[\"testSelectedLengthGreaterThan:\", 0, \"moveUpAndModifySelection\"], [\"moveUp\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "Move Down",
      "key": "j",
      "compound": "[\"testNotEditable\", \"or:\", [[\"testSelectedLengthGreaterThan:\", 0, \"moveDownAndModifySelection\"], [\"moveDown\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "Move Left (Arrow)",
      "key": "",
      "compound": "[\"testNotEditable\", \"or:\", [[\"testSelectedLengthGreaterThan:\", 0, \"moveLeftAndModifySelection\"], [\"moveLeft\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "Move Right (Arrow)",
      "key": "",
      "compound": "[\"testNotEditable\", \"or:\", [[\"testSelectedLengthGreaterThan:\", 0, \"moveRightAndModifySelection\"], [\"moveRight\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "Move Up (Arrow)",
      "key": "",
      "compound": "[\"testNotEditable\", \"or:\", [[\"testSelectedLengthGreaterThan:\", 0, \"moveUpAndModifySelection\"], [\"moveUp\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "Move Down (Arrow)",
      "key": "",
      "compound": "[\"testNotEditable\", \"or:\", [[\"testSelectedLengthGreaterThan:\", 0, \"moveDownAndModifySelection\"], [\"moveDown\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "Move Right (Space)",
      "key": " ",
      "compound": "[\"testNotEditable\", \"or:\", [[\"testSelectedLengthGreaterThan:\", 0, \"moveRightAndModifySelection\"], [\"moveRight\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "Move Left (Backspace)",
      "key": "",
      "compound": "[\"testNotEditable\", \"or:\", [[\"testSelectedLengthGreaterThan:\", 0, \"moveLeftAndModifySelection\"], [\"moveLeft\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "Move Down (^J)",
      "key": "^j",
      "compound": "[\"testNotEditable\", \"or:\", [[\"testSelectedLengthGreaterThan:\", 0, \"moveDownAndModifySelection\"], [\"moveDown\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "Move Down to Start of Line (Return)",
      "key": "\r",
      "compound": "[\"or:\", [[\"testIsEditable\", \"insertNewline\"], [\"testNotEditable\", \"or:\", [[\"testSelectedLengthGreaterThan:\", 0, \"moveParagraphDownAndModifySelection\", \"moveToBeginningOfParagraphAndModifySelection\"], [\"moveParagraphDown\", \"moveToBeginningOfParagraph\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]]]"
    },
    {
      "title": "Move Down to Start of Line",
      "key": "+",
      "compound": "[\"testNotEditable\", \"or:\", [[\"testSelectedLengthGreaterThan:\", 0, \"moveParagraphDownAndModifySelection\", \"moveToBeginningOfParagraphAndModifySelection\"], [\"moveParagraphDown\", \"moveToBeginningOfParagraph\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "Move Down to Start of Line (_)",
      "key": "_",
      "compound": "[\"testNotEditable\", \"or:\", [[\"testSelectedLengthGreaterThan:\", 0, \"moveParagraphDownAndModifySelection\", \"moveToBeginningOfParagraphAndModifySelection\"], [\"moveParagraphDown\", \"moveToBeginningOfParagraph\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "Move Up to Start of Line",
      "key": "-",
      "compound": "[\"testNotEditable\", \"or:\", [[\"testSelectedLengthGreaterThan:\", 0, \"moveParagraphUpAndModifySelection\", \"moveToBeginningOfParagraphAndModifySelection\"], [\"moveParagraphUp\", \"moveToBeginningOfParagraph\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "Word Forward",
      "key": "w",
      "compound": "[\"testNotEditable\", \"or:\", [[\"testSelectedLengthGreaterThan:\", 0, \"moveWordForwardAndModifySelection\"], [\"moveWordForward\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "Word Forward (Shift)",
      "key": "W",
      "compound": "[\"testNotEditable\", \"or:\", [[\"testSelectedLengthGreaterThan:\", 0, \"moveWordForwardAndModifySelection\"], [\"moveWordForward\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "Back Word",
      "key": "b",
      "compound": "[\"testNotEditable\", \"or:\", [[\"testSelectedLengthGreaterThan:\", 0, \"moveWordBackwardAndModifySelection\"], [\"moveWordBackward\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "Back Word (Shift)",
      "key": "B",
      "compound": "[\"testNotEditable\", \"or:\", [[\"testSelectedLengthGreaterThan:\", 0, \"moveWordBackwardAndModifySelection\"], [\"moveWordBackward\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "End of Word",
      "key": "e",
      "compound": "[\"testNotEditable\", \"or:\", [[\"testSelectedLengthGreaterThan:\", 0, \"moveWordForwardAndModifySelection\"], [\"moveWordForward\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "End of Word (Shift)",
      "key": "E",
      "compound": "[\"testNotEditable\", \"or:\", [[\"testSelectedLengthGreaterThan:\", 0, \"moveWordForwardAndModifySelection\"], [\"moveWordForward\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "Start of Line",
      "key": "^",
      "compound": "[\"testNotEditable\", \"or:\", [[\"testSelectedLengthGreaterThan:\", 0, \"moveToBeginningOfParagraphAndModifySelection\"], [\"moveToBeginningOfParagraph\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "Column 0 (|)",
      "key": "|",
      "compound": "[\"testNotEditable\", \"moveToBeginningOfParagraph\", \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "End of Line",
      "key": "$",
      "compound": "[\"testNotEditable\", \"or:\", [[\"testSelectedLengthGreaterThan:\", 0, \"moveToEndOfParagraphAndModifySelection\"], [\"moveToEndOfParagraph\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "Go to Previous Section",
      "key": "{",
      "compound": "[\"testNotEditable\", \"or:\", [[\"testSelectedLengthGreaterThan:\", 0, \"moveParagraphUpAndModifySelection\"], [\"moveParagraphUp\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "Go to Next Section",
      "key": "}",
      "compound": "[\"testNotEditable\", \"or:\", [[\"testSelectedLengthGreaterThan:\", 0, \"moveParagraphDownAndModifySelection\"], [\"moveParagraphDown\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
