    {
      "title": "Go to Line",
      "key": "G",
      "compound": "[\"testNotEditable\", \"or:\", [[\"testNumberWithNameExists:\", \"repeat\", \"moveToLineOfNumberWithName:\", \"repeat\"], [\"moveToEndOfDocument\"]], \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "Match Delimiter",
      "key": "%",
      "compound": "[\"testNotEditable\", \"balanceDelimiters\", \"collapseSelectionToStart\"]"
    },
    {
      "title": "Delete",
