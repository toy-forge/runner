    },
    {
      "title": "Scroll Line Down",
      "key": "^e",
      "compound": "[\"testNotEditable\", \"scrollSelectionToTop\", \"callCompoundCommand:\", \"Helper: Recursive Repeat\", \"callCompoundCommand:\", \"Helper: Motion Post Command\"]"
    },
    {
      "title": "Scroll Line Up",
      "key": "^y",
